# Hosted PostgreSQL requires sslmode=require in the connection URL.
# Use a separate database for tests; never point both URLs at the same database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/placeprep?sslmode=require
DATABASE_URL_TEST=postgresql://USER:PASSWORD@HOST:5432/placeprep_test?sslmode=require

NODE_ENV=development
API_PORT=4000
# JWT access token signing key; refresh tokens are opaque random tokens.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379
# Required when NODE_ENV=production.
CLAMAV_HOST=
CLAMAV_PORT=3310
SEED_USER_PASSWORD=replace-with-a-local-seed-password